# Copy this file to .env and fill in values. Never commit .env.
PORT=3001

# Identify the app to OpenStreetMap (their policy asks for a contact). Example: Smartfood/0.1 (you@example.com)
SMARTFOOD_USER_AGENT=Smartfood/0.1 (student project)

# Kroger Public API (free): https://developer.kroger.com -> Register -> create an app
# Needs the "Products" and "Locations" APIs. Leave blank to disable the deals feature.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
